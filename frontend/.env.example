# Backend API base URL (must include /api).
# Local dev leaves this blank — Vite proxies /api to localhost:4000.
# Production (Vercel): set to your Render URL, e.g.
# VITE_API_URL=https://printwala-api.onrender.com/api
VITE_API_URL=

# ImageKit URL endpoint, e.g. https://ik.imagekit.io/your_imagekit_id
# Optional: the frontend also reads it from the backend's /api/config.
# Set it when you use a custom ImageKit domain so transformations apply
# on the very first render.
VITE_IMAGEKIT_URL_ENDPOINT=
