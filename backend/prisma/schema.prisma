// PrintWala data model
// Postgres in production (Aiven). See .env.example for DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING      // created, awaiting payment
  PAID         // payment captured
  PROCESSING   // admin is fulfilling
  COMPLETED    // delivered
  CANCELLED    // cancelled / failed
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  services  Service[]
}

model Service {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  shortDesc      String
  description    String
  price          Int // price in paise (₹ * 100)
  imageUrl       String?
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  requiresUpload Boolean  @default(false)
  uploadLabel    String   @default("Upload your file")
  // JSON array describing extra booking fields the customer must fill.
  // e.g. [{ "name": "copies", "label": "Number of copies", "type": "number", "required": true }]
  fields         Json     @default("[]")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id       String      @id @default(cuid())
  number   String      @unique // human-friendly, e.g. SH-2026-000123
  status   OrderStatus @default(PENDING)
  amount   Int // in paise

  // customer snapshot (works for guest or logged-in)
  customerName  String
  customerEmail String
  customerPhone String?

  // service-specific answers + notes
  details  Json    @default("{}")
  fileUrl  String?
  fileName String?

  // razorpay linkage
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paidAt            DateTime?

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Editable site content: home hero, about, contact, etc.
// Stored as key -> JSON so admin can manage arbitrary blocks.
model Content {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "home", "about", "contact", "settings"
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
