# ── Database ────────────────────────────────────────────────
# Local docker Postgres (see docker-compose.yml):
DATABASE_URL="postgresql://servihub:servihub@localhost:5432/servihub?schema=public"
# Aiven (production) — copy the "Service URI" and append ?sslmode=require :
# DATABASE_URL="postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require"

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# First admin, created by the seed script:
ADMIN_NAME="PrintWala Admin"
ADMIN_EMAIL="admin@printwala.test"
ADMIN_PASSWORD="admin12345"

# ── Server ──────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN="http://localhost:5173"
# Public base URL of THIS backend, used to build file links
PUBLIC_URL="http://localhost:4000"

# ── ImageKit (image & file CDN) ─────────────────────────────
# From the ImageKit dashboard → Developer options → API keys.
# Leave blank to store uploads on local disk instead (dev only —
# Render/Vercel filesystems are ephemeral, so set these in production).
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
# Root folder in the media library (optional)
IMAGEKIT_FOLDER="/printwala"

# ── Razorpay ────────────────────────────────────────────────
# Leave blank to run in MOCK mode (payments auto-succeed for testing).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# The Key ID is also exposed to the frontend at /api/config
